{
  "name": "dsh-salon",
  "version": "0.1.1",
  "description": "四季沙龙：有独立人设与记忆的 DSH 陪伴群聊、本地视频共看与私聊。",
  "type": "module",
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "shared",
    "web",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.0-rc.2 <1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ccawmiku/dsh-salon.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "deepseek-harness",
    "ai-companion",
    "group-chat"
  ],
  "author": "ccawmiku",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "node scripts/dev.mjs",
    "check": "node scripts/check.mjs",
    "test:ui": "node tests/ui.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "playwright": "^1.56.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "license": "MIT"
}
