{
  "name": "dsh-reasoning-translation",
  "version": "0.2.1",
  "description": "用指定 DSH 模型翻译公开思考，并在聊天流显示译文",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./client": {
      "types": "./src/client.ts",
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json"
  },
  "license": "MIT",
  "engines": {
    "node": ">=24.9.0",
    "dsh": "0.2.1-rc.2 || 0.2.1-rc.3"
  },
  "files": [
    "lib",
    "src",
    "prompts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "locale"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.1-rc.2 || 0.2.1-rc.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-chat": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "external": []
    }
  }
}
