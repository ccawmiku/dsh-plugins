{
  "name": "dsh-plugin-immich",
  "version": "0.1.0",
  "description": "从内网 Immich 获取图片与视频并添加到 DSH 对话框，支持相册瀑布流预览、搜索、多选，以及视频直传与多帧切片模式切换",
  "type": "module",
  "main": "./lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2 <1"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "immich",
    "album",
    "multimodal",
    "video"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-commands"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
